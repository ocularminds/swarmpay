              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a $1,400 plan within the $1,500 budget', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const plan = pm.response.json();",
                  "  pm.expect(plan.totalMinor).to.eql(140000);",
                  "  pm.environment.set('workflowId', plan.id);",
                  "  pm.collectionVariables.set('planVersion', plan.version);",
                  "  pm.collectionVariables.set('tentsLine', plan.lines.find(l => l.category === 'TENTS').id);",
                  "  pm.collectionVariables.set('cateringLine', plan.lines.find(l => l.category === 'CATERING').id);",
                  "});"
                ]
              }
            }
          ]
