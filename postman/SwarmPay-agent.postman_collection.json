              "script": {
                "type": "text/javascript",
                "exec": [
                  "const result = JSON.parse(pm.variables.get('rpc')).result;",
                  "pm.test('the agent reads its organizer\\'s plan', () => pm.expect(result.isError || false).to.eql(false));",
                  "const flow = JSON.parse(result.content[0].text);",
                  "pm.test('catering is authorized and waiting for delivery', () => {",
                  "  pm.expect(flow.orders.find(o => o.category === 'CATERING').status).to.eql('AUTHORIZED');",
                  "  pm.expect(flow.receiptVerified).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set('capturedBefore', flow.capturedMinor);"
                ]
              }
            }
          ]
