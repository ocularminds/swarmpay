    {
      "name": "2 · Be the agent",
      "description": "Only the agent's token: connect over MCP, read the plan, and ask to pay the caterer before delivery.",
      "item": [
        {
          "name": "Connect (initialize)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"initialize\",\n  \"id\": 1,\n  \"params\": {\n    \"protocolVersion\": \"2025-11-25\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman-agent\",\n      \"version\": \"1.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the agent connects with its own token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const rpc = JSON.parse(pm.variables.get('rpc'));",
                  "  pm.expect(rpc.result.serverInfo.name).to.eql('swarm-pay-commerce');",
                  "  pm.collectionVariables.set('mcpProtocol', rpc.result.protocolVersion);",
                  "});"
                ]
              }
            }
          ]
        },
