# Reference only. `node demo/setup.mjs` generates private local demo credentials.
# Never commit a filled environment file. Use a separate .env.sandbox and
# Compose project for sandbox; existing databases cannot change runtime mode.
SWARM_MODE=demo
SWARM_AI_PROVIDER=demo
WEB_PORT=5173
# Webhook-only listener for ngrok; use 5186 in a separate sandbox stack.
WEBHOOK_PORT=5184
# Set both when TLS ingress serves the public deployment.
SWARM_PUBLIC_ORIGIN=
SWARM_SESSION_COOKIE_SECURE=false
PG_ADMIN_PASSWORD=
PG_APP_PASSWORD=
PG_EXECUTOR_PASSWORD=
EXECUTOR_TOKEN=
MCP_TOKEN=
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD=

# Who decides payments, apart from SWARM_MODE: local (the disclosed test
# authority; demo or PayPal sandbox) or decionis (sandbox with an owned
# enforcement key). Blank means local for demo and decionis for sandbox.
SWARM_AUTHORITY=local
# Exact policy version carried by every payment command; the local test
# authority accepts only swarm-pay-demo-v1.
DECIONIS_POLICY_VERSION=swarm-pay-demo-v1
DECIONIS_TENANT_ID=
# Source file used by doctor / install-authority-key.mjs, not a bind mount.
# Install into the project-scoped Docker volume; see docs/sandbox-setup.md.
DECIONIS_KEY_HOST_FILE=./.secrets/decionis-api-key

# Only a public Ed25519 X.509 PEM is mounted into the Java applications.
VENUE_PUBLIC_KEY_HOST_FILE=./.secrets/venue-public.pem
VENUE_ISSUER=demo-venue-fixture
# Only the simulated venue container receives its signing key (base64 PKCS#8).
# node demo/setup.mjs derives it from .secrets/venue-private.pem.
VENUE_PRIVATE_KEY=

# Azure AI can run with simulated payments: SWARM_MODE=demo, SWARM_AI_PROVIDER=azure.
# Canonical names below; initial AZURE_OPEANAI_KEY / AZURE_OPENAI_URL /
# AZURE_OPENAI_LLM spellings are also supported without rewriting their values.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# Only needed when explicitly selecting SWARM_AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional AG Studio licence key for the spend dashboard; without it the dashboard shows a trial watermark.
AG_STUDIO_LICENSE_KEY=
# Required for SWARM_MODE=sandbox; ignored by the simulated payment adapter.
PAYPAL_TENTS_CLIENT_ID=
PAYPAL_TENTS_CLIENT_SECRET=
PAYPAL_TENTS_MERCHANT_ID=
PAYPAL_TENTS_WEBHOOK_ID=
PAYPAL_CATERING_CLIENT_ID=
PAYPAL_CATERING_CLIENT_SECRET=
PAYPAL_CATERING_MERCHANT_ID=
PAYPAL_CATERING_WEBHOOK_ID=
# Sign-up and sign-in with PayPal, from SwarmPay's own app with "Log in with
# PayPal" enabled (docs/sandbox-setup.md). Only the identity container gets the
# secret; the app gets the public client ID. Blank keeps the button hidden.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
# Generated by node demo/setup.mjs: the app's token for the sign-in service.
IDENTITY_TOKEN=
# Buy tents from Channel3's product data (https://channel3.ai). Blank keeps
# tents rental-only. Reached through the egress proxy, like the model.
CHANNEL3_API_KEY=
# Only for node demo/apimatic.mjs, which generates the SDK and API docs portal
# from contracts/apimatic. Never passed to a running service.
APIMATIC_API_KEY=
