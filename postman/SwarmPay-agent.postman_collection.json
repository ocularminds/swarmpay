            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent\": {\n    \"request\": \"An outdoor tech meetup for 30 people at Riverside Pavilion. Rain is forecast. Five tents and catering, $1,500 in total.\",\n    \"attendees\": 30,\n    \"tents\": 5,\n    \"budgetMinor\": 150000,\n    \"eventAt\": \"{{eventAt}}\",\n    \"timezone\": \"UTC\",\n    \"venue\": \"Riverside Pavilion\",\n    \"weather\": \"Rain expected\",\n    \"tentMode\": \"RENT\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
