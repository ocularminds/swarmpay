# Reference only. `node demo/setup.mjs` generates private local demo credentials.
# Never commit a filled environment file. Use a separate .env.sandbox and
# Compose project for sandbox; existing databases cannot change runtime mode.
SWARM_MODE=demo
SWARM_AI_PROVIDER=demo
WEB_PORT=5173
# Webhook-only listener for ngrok; use 5186 in a separate sandbox stack.
WEBHOOK_PORT=5184
PG_ADMIN_PASSWORD=
PG_APP_PASSWORD=
PG_EXECUTOR_PASSWORD=
EXECUTOR_TOKEN=
MCP_TOKEN=
ORGANIZER_USERNAME=organizer
ORGANIZER_PASSWORD=

# Exact policy version carried by every payment command.
DECIONIS_POLICY_VERSION=swarm-pay-demo-v1
DECIONIS_TENANT_ID=
# Source file used by doctor / install-authority-key.mjs, not a bind mount.
# Install into the project-scoped Docker volume; see docs/sandbox-setup.md.
DECIONIS_KEY_HOST_FILE=./.secrets/decionis-api-key

# Only a public Ed25519 X.509 PEM is mounted into the Java applications.
VENUE_PUBLIC_KEY_HOST_FILE=./.secrets/venue-public.pem
VENUE_ISSUER=demo-venue-fixture

# Azure AI can run with simulated payments: SWARM_MODE=demo, SWARM_AI_PROVIDER=azure.
# Canonical names below; initial AZURE_OPEANAI_KEY / AZURE_OPENAI_URL /
# AZURE_OPENAI_LLM spellings are also supported without rewriting their values.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-6-astra
# Only needed when explicitly selecting SWARM_AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Required for SWARM_MODE=sandbox; ignored by the simulated payment adapter.
PAYPAL_TENTS_CLIENT_ID=
PAYPAL_TENTS_CLIENT_SECRET=
PAYPAL_TENTS_MERCHANT_ID=
PAYPAL_TENTS_WEBHOOK_ID=
PAYPAL_CATERING_CLIENT_ID=
PAYPAL_CATERING_CLIENT_SECRET=
PAYPAL_CATERING_MERCHANT_ID=
PAYPAL_CATERING_WEBHOOK_ID=
