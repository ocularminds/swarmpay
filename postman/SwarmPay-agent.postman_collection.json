            "description": "The agent asks to pay the caterer now. There is no delivery receipt, so AgentSafe holds the request and no payment is sent."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const result = JSON.parse(pm.variables.get('rpc')).result;",
                  "const gate = JSON.parse(result.content[0].text);",
                  "pm.test('AgentSafe holds the early request', () => {",
                  "  pm.expect(gate.state).to.eql('ESCALATE');",
                  "  pm.expect(gate.execution).to.eql('HELD');",
                  "});",
                  "pm.test('with a dossier, and no payment result', () => {",
                  "  pm.expect(gate.dossierId).to.be.a('string').and.not.empty;",
                  "  pm.expect(gate.result).to.eql(null);",
                  "});"
                ]
              }
            }
